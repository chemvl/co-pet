{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Co-pet windows",
  "windows": [
    "pet",
    "home",
    "onboarding"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "drag:default",
    "opener:default",
    "dialog:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$APPDATA/library/**" }]
    }
  ]
}
