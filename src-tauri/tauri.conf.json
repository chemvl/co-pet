{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Co-pet",
  "version": "1.0.0",
  "identifier": "com.copet.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "bun run build:mcp && bun run dev",
    "beforeBuildCommand": "bun run build:mcp && bun run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/library/**",
          "$APPDATA/tmp/**",
          "$APPDATA/recordings/**"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["copet"]
      }
    },
    "updater": {
      "pubkey": "OWNER_UPDATER_PUBKEY",
      "endpoints": ["https://updates.owner-domain.invalid/copet/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/copet-mcp"],
    "resources": {
      "resources/llama/": "llama/"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  }
}
