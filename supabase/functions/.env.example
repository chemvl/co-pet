# Secrets for `supabase functions serve` (local backend only; hosted uses `supabase secrets set`).
# Copy to the gitignored supabase/functions/.env.local:
#   cp supabase/functions/.env.example supabase/functions/.env.local
#   supabase functions serve --env-file supabase/functions/.env.local

# `supabase status` › Secret key (service_role). Server-side only — never put it in the app's .env files.
COPET_SERVICE_KEY=

# Dummy values are fine unless you test Notion/Asana OAuth (which needs the hosted project).
NOTION_CLIENT_ID=dummy
NOTION_CLIENT_SECRET=dummy
ASANA_CLIENT_ID=dummy
ASANA_CLIENT_SECRET=dummy
