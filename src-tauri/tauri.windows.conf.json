{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "resources": {
      "target/sherpa-onnx-prebuilt/*/lib/sherpa-onnx-c-api.dll": "./",
      "target/sherpa-onnx-prebuilt/*/lib/onnxruntime*.dll": "./"
    },
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["English", "Vietnamese"], "displayLanguageSelector": false },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
