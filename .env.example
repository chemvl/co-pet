# Co-pet backend config, compiled into the app (`option_env!` in src-tauri/src/backend.rs).
# Copy to a gitignored file per environment:
#   cp .env.example .env.dev    # local Supabase  → bun --env-file=.env.dev run tauri dev
#   cp .env.example .env.prod   # hosted project  → bun --env-file=.env.prod run tauri build --bundles app
# Leave either value empty to build a local-only app (no accounts, sync or OAuth).

# Local: http://127.0.0.1:54321 (`supabase status` › API URL)
# Hosted: https://<ref>.supabase.co
COPET_SUPABASE_URL=

# Publishable (anon) key only — it ships inside the app. Never the service_role/secret key.
# Local: `supabase status` › Publishable key. Hosted: Project Settings › API keys.
COPET_SUPABASE_KEY=

# Release (scripts/release.ts), .env.prod only
# Upgrade rules: app SQLite migrations (src-tauri/src/db/migrations.rs) are append-only (never edit or delete a shipped one).
# The first signed build is installed by hand (DMG), and its permissions must be granted again.

# Developer ID Application identity from Task 7.1 (`security find-identity -v -p codesigning`).
APPLE_SIGNING_IDENTITY=
# App Store Connect API issuer ID from Task 7.1.
APPLE_API_ISSUER=
# App Store Connect API key ID from Task 7.1.
APPLE_API_KEY=
# Path to the AuthKey_<id>.p8 file from Task 7.1.
APPLE_API_KEY_PATH=
# Updater private key from Task 7.1 (`tauri signer generate`), key content not a path.
TAURI_SIGNING_PRIVATE_KEY=
# Password for the updater private key from Task 7.1.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
# Cloudflare R2 bucket name from Task 7.1.
COPET_R2_BUCKET=
# Update host from Task 7.1; must match the tauri.conf.json updater endpoint host.
COPET_UPDATE_HOST=
