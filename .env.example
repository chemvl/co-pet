# Co-pet maintainer scripts config. Copy to `.env` (gitignored); Bun loads it for `bun run`.
# Nothing here is compiled into the app.

# Microsoft Store package identity for `bun run package:msix` (scripts/package-msix.ts), from
# Partner Center › your app › Product identity. Without them only `package:msix --dev-cert` runs.
# Package/Identity/Name, e.g. 12345Publisher.Co-pet
COPET_MSIX_IDENTITY_NAME=
# Package/Identity/Publisher, e.g. CN=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
COPET_MSIX_PUBLISHER=
# Package/Properties/PublisherDisplayName
COPET_MSIX_PUBLISHER_DISPLAY_NAME=

# Website publishing for `bun run publish:site` (scripts/publish-site.ts).
# Store ID from Partner Center › Product identity, e.g. 9NXXXXXXXXXX
COPET_STORE_ID=
# Local checkout of the site repository that site/copet/ is copied into.
COPET_SITE_REPO=
